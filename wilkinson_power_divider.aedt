						CosimulatorType=4
						CosimDefName='DefaultNetlist'
						IsDefinition=true
						Connect=false
						Data(Circuit='TRLK:@ID %0 %1 ?Z(Z=@Z) ?P(P=@P) *K(K=@K) *A(A=@A) ?F(F=@F)', 'Nexxim Circuit'='A@ID %0 %1 ?Z(Z=@Z) ?P(P=@P) *K(K=@K) *A(A=@A) ?F(F=@F) *TAND(TAND=@TAND) *MUR(MUR=@MUR) *SIGMA(SIGMA=@SIGMA) *ENFORCE_CAUSALITY(ENFORCE_CAUSALITY=@ENFORCE_CAUSALITY) COMPONENT=trlk', System='A@ID %0 %1 ?Z(Z=@Z) ?P(P=@P) *K(K=@K) *A(A=@A) ?F(F=@F) COMPONENT=trlk')
						GRef(Circuit='', 'Nexxim Circuit'='', System='')
