		$begin 'Compdefs'
			$begin 'TRLK_NX'
				Library='Nexxim Circuit Elements\\Ideal Distributed'
				CircuitEnv=0
				Refbase='A'
				NumParts=1
				ModSinceLib=false
				Terminal('n1', 'n1', 'A', false, 0, 1, '', 'Electrical', '')
				Terminal('n2', 'n2', 'A', false, 0, 1, '', 'Electrical', '')
				CompExtID=1
				$begin 'Parameters'
					VariablePropNU('Z', 'D', 'Characteristic impedance', '50ohm', 'ohm', AdditionalPropInfo='')
					VariablePropNU('P', 'D', 'Physical length', '10mm', 'meter', AdditionalPropInfo='')
					VariableProp('K', 'D', 'Effective dielectric constant', '1')
					VariableProp('A', 'D', 'Attenuation at reference frequency F (dB/Meter)', '0')
					VariablePropNU('F', 'D', 'Reference frequency for A', '1GHz', 'Hz', AdditionalPropInfo='')
					VariablePropNU('TAND', 'D', 'Dielectric loss tangent', '0', '', AdditionalPropInfo='')
					VariablePropNU('MUR', 'D', 'Effective relative permeability of the dielectric', '1', '', AdditionalPropInfo='')
					VariablePropNU('SIGMA', 'D', 'Bulk conductivity of the dielectric (mho/meter)', '0', '', AdditionalPropInfo='')
					MenuProp('ENFORCE_CAUSALITY', 'D', '1=Use causal model. 0=Use noncausal model. -1=Causal model for Transient, noncausal model for LNA', '-1,0,1', 0)
					TextProp('ModelName', 'SHD', '', 'TRLK')
					ButtonProp('CosimDefinition', 'SD', '', 'Edit', 'Edit', 40501, ButtonPropClientData())
					MenuProp('CoSimulator', 'D', '', 'DefaultNetlist', 0)
				$end 'Parameters'
				$begin 'CosimDefinitions'
